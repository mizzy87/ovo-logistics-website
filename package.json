{
  "name": "ovo-logistics-website",
  "version": "1.0.0",
  "description": "OVO Logistics Services Website",
  "main": "index.html",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:chart": "esbuild chart-component.jsx --bundle --minify --outfile=chart-bundle.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "generate-sitemap": "node generate-sitemap.js",
    "optimize-images": "node compress-images.js",
    "build": "npm run build:chart && npm run generate-sitemap && npm run optimize-images"
  },
  "keywords": [
    "logistics",
    "delivery",
    "nigeria",
    "lagos"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
